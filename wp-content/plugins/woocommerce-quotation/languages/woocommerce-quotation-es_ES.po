#: classes/class-adq-email-manager.php:391
msgid "Your request has been received"
msgstr "Tu solicitud ha sido recibida"

#: classes/class-adq-email-manager.php:392
msgid "Your {site_title} Quote Request from {order_date} is received"
msgstr "Tu solicitud de presupuesto {site_title} ha sido recibida {order_date}"

#: classes/class-adq-email-manager.php:393
#, php-format
msgid ""
"<p>Hello %s!</p><p> Your Quote Request has been received and is now being "
"processed.</p><p></p><p> You can access your account area to view your "
"orders here: %s. </p><p></p><p> %s</p><p></p><p> Your request details are "
"shown below for your reference:</p><p></p><p> %s </p><p></p><p> %s </p><p></"
"p><p> Your comments:</p><p> %s </p><p></p><p> Thanks,</p><p> Best regards!</"
"p>"
msgstr ""
"<p>!Hola %s!</p><p> Su petición ha sido recibida y está siendo procesada "
"ahora.</p><p></p><p> Usted puede acceder al área de su cuenta para ver sus "
"pedidos aquí: %s. </p><p></p><p> %s</p><p></p><p> Los detalles de su "
"petición son mostrados a continuación para su referencia:</p><p></p><p> %s </"
"p><p></p><p> %s </p><p></p><p> Sus comentarios:</p><p> %s </p><p></p><p> "
"¡Gracias y saludos cordiales!</p>"

