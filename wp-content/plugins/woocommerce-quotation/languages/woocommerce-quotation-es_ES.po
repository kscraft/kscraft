msgid "Customer note"
msgstr "Nota de cliente"

#: classes/class-adq-email-manager.php:334
msgid "Customer note emails are sent when you add a note to an order."
msgstr ""
"Las notas a clientes se envían al cliente al añadir una nota a un pedido "
"presupuesto."

#: classes/class-adq-email-manager.php:336
msgid "Note added to your {site_title} order on {order_date}"
msgstr "Nota añadido al pedido de {site_title} del {order_date}"

#: classes/class-adq-email-manager.php:337
#, php-format
msgid ""
"<p>Hello %s, a note has just been added to your order:</p><p> %s </p><p></"
"p><p> You can access your account area to view your orders here: %s. </"
"p><p></p><p> For your reference, your order details are shown below. </"
"p><p></p><p> Order #%s </p><p> %s </p><p></p><p> %s </p><p></p><p> Thanks,</"
"p><p>Best regards!</p>"
msgstr ""
"<p>Hola %s, una nota acaba de ser agregada a su pedido:</p><p> %s </p><p></"
"p><p> Puede acceder al área de su cuenta para ver sus pedidos aquí: %s. </"
"p><p></p><p> Para su referencia, los detalles de su pedido se muestran a "
"continuación. </p><p></p><p> Pedido #%s </p><p> %s </p><p></p><p> %s </"
"p><p></p><p> ¡Gracias y saludos cordiales!</p>"

#: classes/class-adq-email-manager.php:347
msgid "Customer proposal rejected"
msgstr "Propuesta del cliente rechazada"

#: classes/class-adq-email-manager.php:350
msgid "You have declined our {site_title} proposal on {order_date}"
msgstr "Has rechazado el presupuesto de {site_title}, {order_date}"

#: classes/class-adq-email-manager.php:351
#, php-format
msgid ""
"<p>Hello %s!</p><p> Our proposal has been rejected. The proposal is shown "
"below for your reference:</p><p></p><p> You can access your account area to "
"view your orders here: %s.</p><p></p><p> The proposal: %s </p><p> %s </"
"p><p></p><p> %s </p><p></p><p> Thanks,</p><p> Best regards!</p>"
msgstr ""
"<p>¡Hola %s!</p><p> Nuestra propuesta ha sido rechazada. La propuesta es "
"mostrada a continuación para su referencia:</p><p></p><p> Usted puede "
"acceder al área de su cuenta para ver sus pedidos aquí: %s.</p><p></p><p> "
"Propuesta: %s </p><p> %s </p><p></p><p> %s </p><p></p><p> ¡Gracias y saludos "
"cordiales!</p>"

#: classes/class-adq-email-manager.php:361
msgid "Customer proposal accepted"
msgstr "Presupuesto del cliente aceptado"

#: classes/class-adq-email-manager.php:364
msgid "You have accepted our {site_title} proposal from {order_date}"
msgstr "{site_title} Usted ha aceptado nuestro presupuesto, {order_date}"

#: classes/class-adq-email-manager.php:365
#, php-format
msgid ""
"<p>Hello %s!</p><p> Our proposal has been accepted. The proposal is shown "
"below for your reference:</p><p></p><p.> You can proceed with the payment: "
"%s.</p><p></p><p.> You can access your account area to view and pay your "
"orders here: %s.</p><p></p><p.> The proposal: %s</p><p> %s</p><p></p><p.> "
"%s</p><p></p><p.> Thanks,</p><p> Best regards!</p>"
msgstr ""
"<p>¡Hola %s!</p><p> Nuestra propuesta ha sido aceptado. La propuesta es "
"mostrada a continuación para su referencia:</p><p></p><p.> Usted puede "
"proceder con el pago: %s.</p><p></p><p.> Usted puede acceder al área de su "
"cuenta para ver sus pedidos aquí: %s.</p><p></p><p.> Propuesta: %s</p><p> "
"%s</p><p></p><p.> %s</p><p></p><p.> ¡Gracias y saludos cordiales!</p>"

#: classes/class-adq-email-manager.php:375
msgid "Send proposal"
msgstr "Enviar pesupuesto"

#: classes/class-adq-email-manager.php:376
msgid ""
"Send proposal emails are sent to the customer when a proposal is ready for "
"the customer to accept or reject it."
msgstr ""
"Emails enviados al cliente cuando un presupuesto está preparado para que el "
"cliente lo acepte o rechace."

#: classes/class-adq-email-manager.php:377
msgid "Our proposal"
msgstr "Nuestro presupuesto"

#: classes/class-adq-email-manager.php:378
msgid "{site_title} sent a proposal on {order_date}"
msgstr "{site_title} ha enviado un presupuesto, {order_date}"

#: classes/class-adq-email-manager.php:379
#, php-format
msgid ""
"<p>Hello %s!</p><p> Your Quote Request has been processed. Find below our "
"proposal for your reference.</p><p></p><p> You can access your account area "
"to view your proposal here: %s. </p><p></p><p> You can %s or %s our proposal."
"</p><p></p><p> %s </p><p></p><p> Your request details are shown below for "
"your reference: </p><p></p><p> %s</p><p></p><p> %s </p><p></p><p> Thanks,</"
"p><p> Best regards!</p>"
msgstr ""
"<p>¡Hola %s!</p><p> Su petición ha sido procesada. Encuentre a continuación "
"nuestra propuesta para su referencia.</p><p></p><p> Usted puede acceder al "
"área de su cuenta para ver sus pedidos aquí: %s. </p><p></p><p> You can %s o "
"%s nuestra propuesta.</p><p></p><p> %s </p><p></p><p> Los detalles de su "
"petición son mostrados a continuación para su referencia: </p><p></p><p> %s</"
"p><p></p><p> %s </p><p></p><p> ¡Gracias y saludos cordiales!</p>"

