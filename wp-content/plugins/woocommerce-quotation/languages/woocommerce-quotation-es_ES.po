msgstr "Nuestro {site_title} presupuesto, ha sido propuesto  {order_date}"

#: classes/class-adq-email-manager.php:407
#, php-format
msgid ""
"<p>Hello %s! </p><p> This is a reminder of our proposal which is shown below "
"for your reference:</p><p></p><p> You can access your account area to view "
"your orders here: %s.</p><p></p><p> Our proposal: %s</p><p></p><p> %s </"
"p><p></p><p> %s </p><p></p><p> Thanks,</p><p> Best regards!</p>"
msgstr ""
"<p>!Hola %s! </p><p> Este es un recordatorio de nuestra propuesta que se "
"muestra a continuación para su referencia:</p><p></p><p> Usted puede acceder "
"al área de su cuenta para ver sus pedidos aquí: %s.</p><p></p><p> Nuestra "
"propuesta: %s</p><p></p><p> %s </p><p></p><p> %s </p><p></p><p> ¡Gracias y "
"saludos cordiales!</p>"

